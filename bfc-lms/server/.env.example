# BFC LMS — server environment template (PostgreSQL)
# Copy to server/.env and adjust. See INSTALL.md §6 / §14.

NODE_ENV=development
PORT=4000

# --- Local / self-hosted PostgreSQL (discrete params) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bfc_app
DB_PASSWORD=change-me
DB_NAME=bfc_lms
DB_CONNECTION_LIMIT=15

# --- Managed PostgreSQL (e.g. Render): use a connection string instead ---
# When DATABASE_URL is set it takes precedence over the discrete DB_* above
# (DB_USER / DB_PASSWORD / DB_NAME may then be omitted).
# DATABASE_URL=postgres://user:password@host:5432/bfc_lms
# DB_SSL=true
# Render's managed certificate is not in the public CA bundle; either disable
# strict verification (scoped to this managed connection) ...
# DB_SSL_REJECT_UNAUTHORIZED=false
# ... or keep verification on and supply the provider CA (PEM):
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

SESSION_COOKIE_NAME=bfc_session
SESSION_TTL_HOURS=12
# Dev frontend origin (CORS allowlist). On Render set the public URL, e.g.
# https://bfc-lms.onrender.com (comma-separate multiple origins).
CLIENT_ORIGIN=http://localhost:5173

# Secure session cookies require HTTPS. Defaults to true when NODE_ENV=production.
# Set false for a plain-HTTP deployment; true behind TLS / on Render.
# COOKIE_SECURE=false

STORAGE_DIR=../storage
MAX_UPLOAD_MB=200